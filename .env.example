# Copy this file to .env and fill in what you have. Every source is optional:
# the dashboard shows whatever is connected. See README.md for step-by-step setup.

# --- Canvas (Account → Settings → "+ New Access Token") ---
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=

# --- Google Calendar + Gmail (OAuth client, type "Web application") ---
# Redirect URI: http://localhost:4321/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook.com mail + calendar (Microsoft Entra app registration) ---
# Redirect URI: http://localhost:4321/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Extra calendar feeds (.ics links), comma-separated "Name|URL" pairs ---
# e.g. Outlook → Settings → Calendar → Shared calendars → Publish a calendar
ICS_FEEDS=

# --- AI (syllabus reading, email triage, weekly briefing) ---
ANTHROPIC_API_KEY=
# Optional: a cheaper model, e.g. claude-haiku-5-5 (default: claude-opus-5-5)
# ANTHROPIC_MODEL=

# PORT=4321
